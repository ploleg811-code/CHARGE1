{
  "name": "charge-detailing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CHARGE — премиальный детейлинг-центр в Санкт-Петербурге. Многостраничный сайт.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && vite build --config vite.standalone.config.ts",
    "preview": "vite preview",
    "preview:standalone": "npx vite preview --outDir dist-standalone --port 4174",
    "typecheck": "tsc --noEmit",
    "images": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/download-images.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
